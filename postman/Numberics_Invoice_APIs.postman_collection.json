{
  "info": {
    "name": "Numberics Invoice APIs",
    "description": "Run Auth → Login first (sets {{token}}).\n\n• Dashboard: GET /v1/dashboard/summary\n• Invoice / recurring / transactions / NMI / pay-by-token: see folders\n• Onboarding: GET|POST /api/onboarding\n• Taalr chat (in-app): POST /api/chat (folder Taalr Chat — JWT; Managed Agents or Messages API per server config)\n• Public website chat (no auth): POST /api/public/chat (folder Public Website Chat)\n• LLC companies: GET|POST|PATCH /api/llc-northwest/companies (Bearer; user-scoped list after POST create links user_formation_company)\n• view-detail invoice: POST body {\"id\": <invoiceId>}\n• WhatsApp: Twilio sandbox — join code first (postman/README.md).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://www.numbrics.ai/numbricsservice" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json && json.token) { pm.collectionVariables.set('token', json.token); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"atiq.apo@apo.com\",\n  \"password\": \"Atiq.apo@1\"\n}\n"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "description": "KPIs for dashboard cards. Import this collection, run Auth → Login, then GET Dashboard Summary. Super admin sees ALL; other users see only invoices where CREATED_BY = their userId.",
      "item": [
        {
          "name": "GET Dashboard Summary",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "description": "Returns JSON: totalRevenueNmi (NMI SUCCESS payments), totalInvoices, roleCodes[], primaryRoleCode, dataScope (ALL | USER). Path: /v1/dashboard/summary under baseUrl (e.g. .../numbricsservice).",
            "url": "{{baseUrl}}/v1/dashboard/summary"
          }
        }
      ]
    },
    {
      "name": "Invoice",
      "item": [
        {
          "name": "Create Invoice",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Test Customer\",\n  \"customerEmail\": \"customer@example.com\",\n  \"currency\": \"USD\",\n  \"invoiceNum\": \"INV-001\",\n  \"invoiceIssueDate\": \"2025-03-01\",\n  \"invoiceDueDate\": \"2025-03-31\",\n  \"invoiceStatus\": \"DRAFT\",\n  \"taxableAmount\": 100.00,\n  \"totalTaxAmountCalculated\": 100.00,\n  \"invoiceProductList\": [\n    { \"productName\": \"Item 1\", \"quantity\": 1, \"amount\": 100.00 }\n  ]\n}\n"
            },
            "url": "{{baseUrl}}/v1/invoice/create-invoice"
          }
        },
        {
          "name": "Invoice List",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pageNumber\": 1,\n  \"pageSize\": 20\n}\n"
            },
            "url": "{{baseUrl}}/v1/invoice/list"
          }
        },
        {
          "name": "View Detail (by id)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"id\": 1\n}\n" },
            "url": "{{baseUrl}}/v1/invoice/view-detail"
          }
        },
        {
          "name": "View Detail by Customer Name",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"customerName\": \"Test Customer\"\n}\n" },
            "url": "{{baseUrl}}/v1/invoice/view-detail-by-customer-name"
          }
        },
        {
          "name": "View Detail by Invoice Num",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
