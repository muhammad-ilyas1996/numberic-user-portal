              "raw": "{\n  \"name\": \"Monthly Retainer Updated\",\n  \"customerName\": \"Acme Corp\",\n  \"customerEmail\": \"acme@example.com\",\n  \"currency\": \"USD\",\n  \"frequency\": \"MONTHLY\",\n  \"startDate\": \"2025-03-01\",\n  \"dueDays\": 30,\n  \"taxableAmount\": 600.00,\n  \"items\": [\n    { \"productName\": \"Consulting\", \"quantity\": 1, \"amount\": 600.00 }\n  ]\n}\n"
