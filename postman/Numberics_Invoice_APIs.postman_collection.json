              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"id\": 1\n}\n" },
            "url": "{{baseUrl}}/v1/invoice/delete-invoice"
          }
        },
        {
          "name": "Send Invoice (WhatsApp)",
