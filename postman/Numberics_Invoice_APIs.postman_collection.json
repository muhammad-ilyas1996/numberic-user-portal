              "raw": "{\n  \"customerName\": \"Test Customer\",\n  \"customerEmail\": \"customer@example.com\",\n  \"currency\": \"USD\",\n  \"invoiceNum\": \"INV-001\",\n  \"invoiceIssueDate\": \"2025-03-01\",\n  \"invoiceDueDate\": \"2025-03-31\",\n  \"invoiceStatus\": \"DRAFT\",\n  \"taxableAmount\": 100.00,\n  \"totalTaxAmountCalculated\": 100.00,\n  \"invoiceProductList\": [\n    { \"productName\": \"Item 1\", \"quantity\": 1, \"amount\": 100.00 }\n  ]\n}\n"
