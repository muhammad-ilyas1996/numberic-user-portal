        }
      ]
    },
    {
      "name": "TaxBandits — Form 1099-K (Webhook + PDF)",
      "description": "TaxBandits callbacks + helper endpoints added for automated PDF zip ingestion.\n\nNotes:\n• `/api/taxbandits/**` is intentionally public in this service (see SecurityConfig).\n• Webhook must return HTTP 200 quickly; heavy work happens async on server.\n• After PDF_COMPLETE webhook is processed, artifacts land under `uploads/taxbandits/webhooks/...` and `GET pdf-artifact` returns latest manifest.\n• `POST /api/taxbandits/form1099transactions` → TaxBandits `Form1099Transactions`; `submit-and-create` (K), `submit-and-create-nec`, `submit-and-create-misc` → txn then Create with RecipientId mapping.",
      "item": [
        {
          "name": "POST Form1099Transactions",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
