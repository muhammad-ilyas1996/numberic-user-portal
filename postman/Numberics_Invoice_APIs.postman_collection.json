            "url": "{{baseUrl}}/v1/invoice/send"
          }
        },
        {
          "name": "Send History",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"invoiceId\": 1,\n  \"pageNumber\": 1,\n  \"pageSize\": 20\n}\n" },
            "url": "{{baseUrl}}/v1/invoice/send-history"
          }
        },
        {
          "name": "Download PDF",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"id\": 1\n}\n" },
            "url": "{{baseUrl}}/v1/invoice/download-pdf"
          }
        },
        {
          "name": "Transactions List",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pageNumber\": 1,\n  \"pageSize\": 20\n}\n"
            },
            "url": "{{baseUrl}}/v1/invoice/transactions/list"
          }
        }
      ]
    },
    {
      "name": "Invoice (Public - No Auth)",
      "item": [
        {
          "name": "Pay by Token (GET)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/invoice/pay-by-token?token=PASTE_TOKEN_HERE",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "invoice", "pay-by-token"],
              "query": [{ "key": "token", "value": "PASTE_TOKEN_HERE" }]
            }
          }
        },
        {
          "name": "Pay with Token (NMI)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"PASTE_TOKEN_FROM_LINK\",\n  \"cardNumber\": \"4111111111111111\",\n  \"cardExpiry\": \"1225\",\n  \"cardCvv\": \"123\",\n  \"customerInfo\": {\n    \"firstName\": \"Test\",\n    \"lastName\": \"User\",\n    \"email\": \"test@example.com\"\n  }\n}\n"
            },
            "url": "{{baseUrl}}/v1/invoice/pay-with-token"
          }
        }
      ]
    },
    {
      "name": "Recurring Invoice",
      "item": [
        {
          "name": "Recurring Create",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Monthly Retainer\",\n  \"customerName\": \"Acme Corp\",\n  \"customerEmail\": \"acme@example.com\",\n  \"currency\": \"USD\",\n  \"frequency\": \"MONTHLY\",\n  \"startDate\": \"2025-03-01\",\n  \"dueDays\": 30,\n  \"taxableAmount\": 500.00,\n  \"items\": [\n    { \"productName\": \"Consulting\", \"quantity\": 1, \"amount\": 500.00 }\n  ]\n}\n"
            },
            "url": "{{baseUrl}}/v1/invoice/recurring/create"
          }
        },
        {
          "name": "Recurring List",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pageNumber\": 1,\n  \"pageSize\": 20\n}\n"
            },
            "url": "{{baseUrl}}/v1/invoice/recurring/list"
          }
        },
        {
          "name": "Recurring View (GET by id)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/v1/invoice/recurring/1"
          }
        },
        {
          "name": "Recurring Update",
          "request": {
            "method": "PUT",
