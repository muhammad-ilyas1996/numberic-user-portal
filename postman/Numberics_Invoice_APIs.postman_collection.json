            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 1,\n  \"customerName\": \"Test Customer Updated\",\n  \"customerEmail\": \"customer@example.com\",\n  \"currency\": \"USD\",\n  \"invoiceNum\": \"INV-001\",\n  \"invoiceStatus\": \"DRAFT\",\n  \"taxableAmount\": 150.00,\n  \"totalTaxAmountCalculated\": 150.00,\n  \"invoiceProductList\": []\n}\n"
            },
            "url": "{{baseUrl}}/v1/invoice/update-invoice"
          }
        },
