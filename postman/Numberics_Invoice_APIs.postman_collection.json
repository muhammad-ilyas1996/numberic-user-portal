      ]
    },
    {
      "name": "Settings (Merchant NMI)",
      "item": [
        {
          "name": "Get My NMI Config",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/v1/settings/nmi"
          }
        },
        {
          "name": "Save My NMI Config (API Key)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"authMethod\": \"api_key\",\n  \"securityKey\": \"YOUR_NMI_SECURITY_KEY_FROM_PORTAL\"\n}\n"
            },
            "url": "{{baseUrl}}/v1/settings/nmi"
          }
        },
        {
          "name": "Save My NMI Config (Username/Password)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"authMethod\": \"username_password\",\n  \"nmiUsername\": \"YourNMIUsername\",\n  \"nmiPassword\": \"YourNMIPassword\"\n}\n"
            },
            "url": "{{baseUrl}}/v1/settings/nmi"
          }
        }
      ]
    },
    {
      "name": "LLC Northwest (Companies)",
      "description": "Corporate Tools companies. Auth: Bearer {{token}}.\n\n• INVALID_HOME_STATE: use full state name (Delaware) not DE.\n• INVALID_ENTITY_TYPE: CT rejects \"LLC\" — use \"llc\" (lowercase) or \"limited_liability_company\" (see alternate POST requests).\n• Change \"name\" each test if duplicate_name_allowed is false.\n• Optional: GET Filing Products (same folder in codebase path) to align entity/jurisdiction with CT.",
      "item": [
        {
          "name": "GET Filing Products (discover entity/jurisdiction)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/llc-northwest/filing-products?url=https://example.com&jurisdiction=Delaware&entityType=llc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "llc-northwest", "filing-products"],
              "query": [
                { "key": "url", "value": "https://example.com" },
                { "key": "jurisdiction", "value": "Delaware" },
                { "key": "entityType", "value": "llc" }
              ]
            }
          }
        },
        {
          "name": "GET Companies",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/llc-northwest/companies?limit=20&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["api", "llc-northwest", "companies"],
              "query": [
                { "key": "limit", "value": "20", "description": "optional" },
                { "key": "offset", "value": "0", "description": "optional" }
              ]
            }
          }
        },
        {
          "name": "POST Companies (create — entity_type llc)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "description": "Use lowercase \"llc\" (CT returns INVALID_ENTITY_TYPE for \"LLC\"). Change name if duplicate error.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"duplicate_name_allowed\": false,\n  \"companies\": [\n    {\n      \"name\": \"Postman Test LLC 001\",\n      \"entity_type\": \"llc\",\n      \"home_state\": \"Delaware\"\n    }\n  ]\n}\n"
            },
            "url": "{{baseUrl}}/api/llc-northwest/companies"
          }
        },
        {
          "name": "POST Companies (create — entity_type limited_liability_company)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "description": "If \"llc\" still fails, try this snake_case value (some CT environments use it).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"duplicate_name_allowed\": false,\n  \"companies\": [\n    {\n      \"name\": \"Postman Test LLC 002\",\n      \"entity_type\": \"limited_liability_company\",\n      \"home_state\": \"Delaware\"\n    }\n  ]\n}\n"
            },
            "url": "{{baseUrl}}/api/llc-northwest/companies"
          }
        },
        {
          "name": "POST Companies (create — jurisdictions Wyoming)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "description": "CT rule: provide jurisdictions OR home_state, not both. No home_state here.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"duplicate_name_allowed\": false,\n  \"companies\": [\n    {\n      \"name\": \"Postman Test LLC 003\",\n      \"entity_type\": \"llc\",\n      \"jurisdictions\": [\"Wyoming\"]\n    }\n  ]\n}\n"
            },
            "url": "{{baseUrl}}/api/llc-northwest/companies"
          }
        },
        {
          "name": "PATCH Companies (update)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"duplicate_name_allowed\": false,\n  \"companies\": [\n    {\n      \"company_id\": \"PASTE-UUID-FROM-GET-OR-POST-RESPONSE\"\n    }\n  ]\n}\n"
            },
            "url": "{{baseUrl}}/api/llc-northwest/companies"
          }
        }
      ]
    },
    {
      "name": "Onboarding (Taalr)",
      "item": [
        {
          "name": "GET Onboarding",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/onboarding"
          }
        },
        {
          "name": "POST Onboarding (Submit Questionnaire)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"businessName\": \"Acme LLC\",\n  \"entityType\": \"LLC\",\n  \"registrationState\": \"California\",\n  \"industry\": \"Technology\",\n  \"revenueLastYear\": \"$100k - $500k\",\n  \"revenueExpected\": \"$500k - $1M\",\n  \"collectsSalesTax\": \"Yes\",\n  \"multiState\": \"No\",\n  \"hasEmployees\": \"Yes\",\n  \"teamSize\": \"5-10\",\n  \"filesQuarterlyTaxes\": \"Yes\",\n  \"salesTaxFrequency\": \"Quarterly\",\n  \"taxFilingsUpToDate\": \"Yes\",\n  \"accountingSoftware\": \"QuickBooks\",\n  \"connectBankAccounts\": \"Yes\",\n  \"goals\": \"Simplify bookkeeping and stay compliant\",\n  \"location\": \"San Francisco, CA\",\n  \"onboardingTrack\": \"BUSINESS_OWNER\",\n  \"filingStatus\": \"Married filing jointly\",\n  \"incomeSourceCodes\": \"1,3,5\",\n  \"painPointCode\": \"2\",\n  \"operationsCodes\": \"1,2,6\",\n  \"taxProRelationship\": \"3\",\n  \"businessTierChoice\": \"STANDARD\",\n  \"taxProCredential\": null,\n  \"practiceClientBand\": null,\n  \"practiceTaxSoftware\": null,\n  \"practicePainCodes\": null,\n  \"onboardingAnswersJson\": \"{\\\"s1\\\":\\\"3\\\",\\\"s2\\\":[\\\"1\\\",\\\"3\\\"],\\\"completed\\\":true}\"\n}\n"
            },
            "url": "{{baseUrl}}/api/onboarding"
          }
        }
      ]
    },
    {
      "name": "Taalr Chat",
      "description": "In-app Taalr (Anthropic). Requires Auth → Login.\n\nBody:\n• message (required)\n• resetSession: true = new sesn_ session (clears old chat memory)\n• includeProfileInPrompt: false = do not send saved business profile to Taalr (use with resetSession to re-run onboarding)\n\n429 = rate limit.",
      "item": [
        {
          "name": "POST /api/chat",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Hi — start onboarding\",\n  \"resetSession\": false,\n  \"includeProfileInPrompt\": true\n}\n"
            },
            "url": "{{baseUrl}}/api/chat"
          }
        }
      ]
    },
    {
      "name": "Public Website Chat",
      "description": "Website chat widget endpoint. No JWT, no rate limit, stateless (no DB history).",
      "item": [
        {
          "name": "POST /api/public/chat",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Hello from website\"\n}\n"
            },
            "url": "{{baseUrl}}/api/public/chat"
          }
        }
      ]
    }
  ]
}
